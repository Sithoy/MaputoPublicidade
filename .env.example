# Backend-generated documents
COMPANY_LEGAL_NAME=Maputo Publicidade & Serviços, Lda
COMPANY_NUIT=400558272
COMPANY_ADDRESS=Rua da Resistência N.º 1550, R/C, Maputo, Moçambique
COMPANY_EMAIL=info@maputopublicidade.com
COMPANY_PHONE=+258 21 41 66 03 · +258 82 55 55 736 · +258 84 74 12 838
COMPANY_BANK_NAME=BCI
COMPANY_BANK_ACCOUNT=10 83 25 624 10001
COMPANY_BANK_NIB=0008 00000 8325 624 10195

# Email (console backend in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@maputopublicidade.com
ADMIN_EMAIL=admin@maputopublicidade.co.mz

# Social login (backend-only secrets; configure these on Render)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Use "common" for personal + organisational Microsoft accounts, or a tenant ID.
MICROSOFT_OAUTH_TENANT=common

# File storage (leave AWS_STORAGE_BUCKET_NAME empty to use local FileSystemStorage)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# Cache (optional; leave empty to use LocMemCache)
REDIS_URL=

# Throttling
THROTTLE_ANON=100/minute
THROTTLE_USER=1000/minute

# Sentry / monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=INFO

# Local development test accounts (DO NOT enable in production)
SEED_TEST_USERS=True
NEXT_PUBLIC_ENABLE_TEST_CREDENTIALS=true
# Credentials shown by the "Entrar com conta de teste" button on the login pages.
# Must match the users created by `python manage.py seed_test_users`.
NEXT_PUBLIC_TEST_ADMIN_EMAIL=testadmin@maputopublicidade.co.mz
NEXT_PUBLIC_TEST_ADMIN_PASSWORD=admin12345
NEXT_PUBLIC_TEST_CLIENT_EMAIL=cliente@maputopublicidade.co.mz
NEXT_PUBLIC_TEST_CLIENT_PASSWORD=cliente12345

# Payments (mock until M-Pesa credentials are available)
PAYMENT_PROVIDER=mock
# Shared secret used to verify M-Pesa/eMola webhook signatures (HMAC-SHA256).
# Required when PAYMENT_PROVIDER is not "mock" in production.
PAYMENT_WEBHOOK_SECRET=
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_ENVIRONMENT=sandbox
MPESA_ORIGIN=developer.mpesa.vm.co.mz
MPESA_CALLBACK_URL=

# SMS (none | africastalking | twilio)
SMS_BACKEND=none
SMS_FROM=MaputoPublicidade
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
