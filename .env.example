# PostgreSQL for local Docker development
POSTGRES_DB=maputopublicidade
POSTGRES_USER=mp_user
POSTGRES_PASSWORD=mp_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Neon / production database
# Render should receive this as a secret from Neon, for example:
# postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=
DATABASE_SSL_REQUIRE=True

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SERVE_MEDIA=False

# Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WHATSAPP_NUMBER=258825555736
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Maputo Publicidade & Serviços, Lda
NEXT_PUBLIC_COMPANY_DISPLAY_NAME=Maputo Publicidade
