NEXT_PUBLIC_COMPANY_ADDRESS=Rua da Resistência N.º 1550, R/C, Maputo, Moçambique
NEXT_PUBLIC_COMPANY_STREET_ADDRESS=Rua da Resistência N.º 1550, R/C
NEXT_PUBLIC_COMPANY_CITY=Maputo
NEXT_PUBLIC_COMPANY_COUNTRY_CODE=MZ
NEXT_PUBLIC_COMPANY_EMAIL=info@maputopublicidade.com
NEXT_PUBLIC_COMPANY_PHONE=+258 21 41 66 03 · +258 82 55 55 736 · +258 84 74 12 838
NEXT_PUBLIC_COMPANY_PRIMARY_PHONE=+258 82 55 55 736
