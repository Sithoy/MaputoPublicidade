FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHON_DOTENV_DISABLED=1 \
    DEBUG=False \
    PORT=8080

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . ./
# Static collection needs no production credentials or database connection.
RUN python manage.py collectstatic --noinput \
    && useradd --uid 10001 --create-home app \
    && chmod 0555 /app/cloudrun/entrypoint.sh \
    && chown -R app:app /app

ARG APP_REVISION
ENV MP_RELEASE_SHA=${APP_REVISION}
RUN python -c "import os,re,sys; sys.exit(0 if re.fullmatch('[a-f0-9]{40}', os.environ.get('MP_RELEASE_SHA', '')) else 'APP_REVISION must be a full Git commit SHA')"

USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/app/cloudrun/entrypoint.sh"]
